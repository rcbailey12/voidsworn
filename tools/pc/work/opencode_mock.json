{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "openai": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "http://127.0.0.1:8765/v1",
        "apiKey": "dry"
      },
      "models": {
        "gpt-6.2-sol": {
          "name": "GPT 6.2 Sol (issue 985)",
          "reasoning": true,
          "limit": { "context": 1050000, "output": 128000 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol (issue 985)",
          "reasoning": true,
          "limit": { "context": 1050000, "output": 128000 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "gpt-6.1-terra": {
          "name": "GPT 6.1 Terra (issue 985)",
          "reasoning": true,
          "limit": { "context": 1050000, "output": 128000 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "gpt-6.2-astra": {
          "name": "GPT 6.2 Astra (issue 1408)",
          "reasoning": true,
          "limit": { "context": 1050000, "output": 128000 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        }
      }
    },
    "deepseek": {
      "options": {
        "baseURL": "http://127.0.0.1:8765/v1"
      }
    },
    "moonshotai": {
      "options": {
        "baseURL": "http://127.0.0.1:8765/v1"
      }
    },
    "kimicode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kimi Code plan (stand-in)",
      "options": {
        "baseURL": "http://127.0.0.1:8765/v1",
        "apiKey": "dry"
      },
      "models": {
        "kimi-for-coding": {
          "name": "stand-in",
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "k3.1-pro": {
          "name": "stand-in",
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "k3": {
          "name": "stand-in",
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:8765/v1",
        "apiKey": "dry"
      },
      "models": {
        "claude-sonnet-5-5": {
          "name": "stand-in"
        },
        "claude-opus-5-5": {
          "name": "stand-in"
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "*git push*": "deny",
      "*git commit*": "deny",
      "*git -c*": "deny",
      "*rm -r*": "deny",
      "*rm -fr*": "deny",
      "*rmdir*": "deny",
      "*Remove-Item*": "deny"
    }
  }
}
