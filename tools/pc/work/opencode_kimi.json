{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "*git push*": "deny",
      "*git commit*": "deny",
      "*git -c*": "deny",
      "*rm -r*": "deny",
      "*rm -fr*": "deny",
      "*rmdir*": "deny",
      "*Remove-Item*": "deny"
    }
  },
  "provider": {
    "kimicode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kimi Code plan (issue 597)",
      "options": {
        "baseURL": "https://api.kimi.com/coding/v1",
        "apiKey": "{env:KIMI_CODE_API_KEY}"
      },
      "models": {
        "kimi-for-coding": {
          "name": "Kimi for coding (the plan's current coding model)"
        }
      }
    }
  },
  "tools": {
    "task": false
  }
}
