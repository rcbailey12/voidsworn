+# R256 (Ryan, Nov 15 2026, on the painted S8: "Lighten a step"; issue 781): the iron pairs one step lighter, toward the concept's
+# grey. CONCEPT above keeps the tones as sampled (sunward.md section 2; the battle median audit reads its iron band); pair() paints
+# the iron family through this step. Each tone's brightest channel x moves up as WEAR_FLOOR * (x / WEAR_FLOOR) ** IRON_STEP and
+# its other channels scale with it in linear, so its hue holds: the dark ends rise most, the light ends a little, the family order
+# (shade, dark, iron, cast and worked) holds, and every plate stays under the wear tones (sunward.md 4: #656564 to #848382 are
+# wear tones only, never plate tones). Not the lift and not the light (LIFT and LIGHT_GAIN are unchanged); soot, liner, wear and
+# frost do not move. IRON_STEP 1.0 gives the sampled tones back.
+IRON_STEP = .60
+IRON_STEP_KEYS = ('iron', 'iron_shade', 'iron_dark', 'iron_cast', 'worked')
+WEAR_FLOOR = float(min(CONCEPT['wear'][0]))
+
+
+def stepped(srgb):
+    """an iron tone (sRGB show-tone) after the R256 step, as sRGB floats"""
+    x = float(max(srgb))
+    if x <= 0 or x >= WEAR_FLOOR: return tuple(float(c) for c in srgb)
+    k = lin_raw((WEAR_FLOOR * (x / WEAR_FLOOR) ** IRON_STEP,))[0] / lin_raw((x,))[0]
+    c = np.clip(np.asarray(lin_raw(srgb)) * k, 0, 1)
+    return tuple(float(v) * 255.0 for v in np.where(c <= .0031308, c * 12.92, 1.055 * c ** (1 / 2.4) - .055))
+
+
 def pair(k):
-    lo, hi = CONCEPT[k]; return lin(lo), lin(hi)
+    lo, hi = CONCEPT[k]
+    if k in IRON_STEP_KEYS: lo, hi = stepped(lo), stepped(hi)
+    return lin(lo), lin(hi)
 
 
