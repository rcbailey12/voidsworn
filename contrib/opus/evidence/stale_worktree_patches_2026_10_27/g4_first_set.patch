+		"ion", "doom":
+			out.append(surface(p, n, L * 0.06 * wk, seed_v, S_ION))
+		"macro", "battery", "auto", "scatter", "prism", "guns":
+			if look in ["auto", "scatter", "guns"]:
+				out.append(cluster(p, n, L * 0.025 * wk, 7, L * 0.004, 0.15, seed_v, S_FLAK))
+			else:
+				out.append(crater(p, n, L * 0.016 * wk, L * 0.007 * wk, seed_v, S_SHELL))
+		"plasma":
+			out.append(crater(p, n, L * 0.02 * wk, L * 0.009 * wk, seed_v, S_PLASMA))
+		"flak", "pflak", "mflak", "gflak":
+			out.append(cluster(p, n, L * 0.04 * wk, 10, L * 0.0045, 0.25, seed_v, S_FLAK))
+		"spine", "tendril", "sporeb", "spores":
+			var e := cluster(p, n, L * 0.03 * wk, 7, L * 0.006, 0.35, seed_v, S_ACID)
+			e.dir = -dir if look in ["spine", "tendril"] else Vector3.ZERO
