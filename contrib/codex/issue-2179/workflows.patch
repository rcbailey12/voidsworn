+++ b/.github/workflows/main_checks.yml
@@ -0,0 +1,17 @@
+# Test main itself after each merge (no checks ran on main before: 72 percent of merges landed after other code had
+# reached main since the PR's last push). Board log pushes skip it; a newer merge cancels an older run.
+name: main checks
+on:
+  push:
+    branches: [main]
+    paths-ignore:
+      - 'contrib/opus/LOOP.md'
+      - 'contrib/opus/FINDINGS.md'
+permissions:
+  contents: read
+concurrency:
+  group: main-checks
+  cancel-in-progress: true
+jobs:
+  checks:
+    uses: ./.github/workflows/checks.yml
diff --git a/.github/workflows/stale_work.yml b/.github/workflows/stale_work.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/stale_work.yml
@@ -0,0 +1,38 @@
+# Stale work sweep (ways-of-working audit, Nov 25 2026). Every two hours, list work that was done but is not moving
+# (contrib/opus/tools/stale_work.js) and send any job branch that never got a pull request back through auto-pr
+# (codex/issue-2148 and 2149 were pushed during the Nov 25 GitHub outage and sat with none). Reads with REST only.
+# The report goes to this run's summary and, when the STALE_ISSUE variable names an issue, replaces that issue's body.
+name: stale-work
+on:
+  schedule:
+    - cron: '17 */2 * * *'
+  workflow_dispatch:
+concurrency:
+  group: stale-work
+  cancel-in-progress: true
+permissions:
+  contents: read
+  pull-requests: read
+  checks: read       # read All checks for open pull requests
+  issues: write      # only the STALE_ISSUE body
+  actions: write     # only to start auto-pr for a branch with no PR
+jobs:
+  sweep:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          sparse-checkout: |
+            .github/workflows
+            contrib/opus/tools/stale_work.js
+          sparse-checkout-cone-mode: false
+      - name: Sweep
+        env:
+          GH_TOKEN: ${{ github.token }}
+          STALE_ISSUE: ${{ vars.STALE_ISSUE }}
+        run: |
+          set -e
+          args=(--github --dispatch)
+          if [ -n "$STALE_ISSUE" ]; then args+=(--issue "$STALE_ISSUE"); fi
+          node contrib/opus/tools/stale_work.js "${args[@]}"
