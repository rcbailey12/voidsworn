-	var L: float = hull.L
+static func marks_for(hull, look: String, w: int, p: Vector3, n: Vector3, dir: Vector3, seed_v: float, faction := "", grow := 1.0, section_damage := 1.0) -> Array:
+	var L: float = hull.L * (0.12 + 0.88 * pow(clampf(section_damage, 0.0, 1.0), 0.9))
