+				var expected := {}
+				for k in view.terrain:
+					if api.R.blocks(view.terrain[k]): expected[k] = view.terrain[k]
+				if api.R.SOLID != null:
+					for k in api.R.SOLID: expected[k] = api._blocker_kind(int(str(k).split(",")[0]), int(str(k).split(",")[1]))
+				for k in expected:
+					var qr: PackedStringArray = str(k).split(",")
+					var p := board.hex_world(int(qr[0]), int(qr[1]))
+					var kind: String = expected[k]
+					if kind in ["planet", "station", "deadstar"]:
+						# Protected models: require the exact visible exclusion rim at
+						# this hex, without claiming that it repairs the model silhouette.
+						check(board.blocker_visuals.visuals.has(k), "protected footprint missing: " + k)
+						protected_footprints += 1
+					else:
+						check(_contains(board.props, p) or _batch_contains(world, p), "solid missing: %s %s %s %s" % [map, shape, kind, k])
+					total += 1
