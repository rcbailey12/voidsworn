2}}]},{"id":"veterans","t":"A retired admiral","b":"An old admiral in a ruined hab offers to teach your captains everything she learned, for a price.","o":[{"k":"pay","l":"Pay her (50 credits)","s":"Every captain gains 25 experience.","r":{"cost":50,"xp":25}},{"k":"oath","l":"Swear her old oath","s":"She teaches for free: every captain gains 25 experience.","need":{"fac":"voidsworn"},"r":{"xp":25}},{"k":"leave","l":"Thank her and leave","s":"Nothing happens.","r":{}}]},{"id":"haven","t":"A pirate haven","b":"A rock riddled with docking tunnels and gun ports. Half the sector’s stolen goods pass through here.","o":[{"k":"raid","l":"Raid it","s":"Fight an elite Corsair battle. Win a relic.","r":{"fight":"corsair"},"fl":{"loud":1}},{"k":"tribute","l":"Pay them to hide your trail (40 credits)","s":"Nemesis clock back one.","r":{"cost":40,"nemClock":-1}},{"k":"recruit","l":"Recruit a crew there","s":"A Corsair raider joins with a veteran captain.","need":{"fac":"corsair"},"r":{"shipRaw":"c_raider","vet":1}}]},{"id":"quiet","t":"Quiet void","b":"Nothing on the scopes for light-hours in every direction. The crews sleep for the first time in weeks.","o":[{"k":"rest","l":"Rest","s":"Every ship repairs 10% of its hull.","r":{"healAll":"#d:3fb999999999999a"}},{"k":"drill","l":"Drill the crews","s":"Every captain gains 10 experience.","r":{"xp":10}}]}],"EVENT_FALLBACK":"quiet","NEM_CLOCK":4,"NEM_WEAK":{"flank":{"n":"Thin stern plating","d":"His ships take 25% more damage on rear-arc hits."},"ion":{"n":"Brittle shield emitters","d":"Ion and lance hits strip 50% more shield from his ships."},"torp":{"n":"Poor point defense","d":"Torpedoes are 15 easier to land on his ships."},"board":{"n":"Green boarding crews","d":"His ships carry 30% fewer crew to repel boarders."},"brawl":{"n":"Long-gun doctrine","d":"His ships aim 10 worse at targets 2 hexes away or closer."},"anchor":{"n":"A proud flagship","d":"His escorts break and flee once his flagship falls below 60% hull."},"slow":{"n":