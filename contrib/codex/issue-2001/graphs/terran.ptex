    {
      "name": "Dry_surface_grain",
      "type": "fbm4",
      "parameters": {
        "noise": 0,
        "scale_x": 32,
        "scale_y": 32,
        "iterations": 4,
        "folds": 0,
        "offset": 0,
        "persistence": 0.55,
        "lacunarity": 2
      },
      "node_position": {
        "x": 0,
        "y": 265
      },
      "seed_int": 29714
    },
    {
      "name": "Surface",
      "type": "shader",
      "parameters": {},
      "node_position": {
        "x": 570,
        "y": -100
      },
      "shader_model": {
        "name": "Packed live relief and dry surface grain",
        "shortdesc": "Packed live relief and dry surface grain",
        "longdesc": "Packed live relief and dry surface grain",
        "instance": "",
        "code": [
          "vec2 warp = vec2($bend($uv + vec2(0.17, 0.57)), $bend($uv.yx + vec2(0.76, 0.12))) - 0.5;",
          "float upland = $land($uv + 0.25 * warp);",
          "float fine = $fine($uv - 0.09 * warp);",
          "float canopy = $grain($uv);",
          "float valley = (1.0 - smoothstep(0.28, 0.48, upland));",
          "float coarse_h = 0.516 + 1.65 * (upland - 0.5) - 0.10 * valley;",
          "float fine_h = 0.5 + 1.32 * (fine - 0.5);",
          "float cavity = 1.0 - 0.14 * valley;",
          "float albedo = 0.521 + 1.18 * (canopy - 0.5) - 0.10 * valley;",
          "float roughness = mix(0.68, 0.88, smoothstep(0.30, 0.70, fine));"
        ],
        "global": "",
        "inputs": [
          {
            "name": "bend",
            "label": "Bend",
            "type": "f",
            "default": "0.5"
          },
          {
            "name": "land",
            "label": "Land",
            "type": "f",
            "default": "0.5",
            "function": true
          },
          {
            "name": "fine",
            "label": "Fine",
            "type": "f",
            "default": "0.5",
            "function": true
          },
          {
            "name": "grain",
            "label": "Grain",
            "type": "f",
            "default": "0.5"
          }
        ],
        "outputs": [
          {
            "type": "rgba",
            "shortdesc": "Game RGBA",
            "rgba": "clamp(vec4(coarse_h, cavity, fine_h, albedo), 0.0, 1.0)"
          },
          {
            "type": "f",
            "shortdesc": "Height preview",
            "f": "coarse_h"
          },
          {
            "type": "f",
            "shortdesc": "Roughness",
            "f": "roughness"
          },
          {
            "type": "f",
            "shortdesc": "Color grain preview",
            "f": "albedo"
          }
        ],
        "parameters": []
      }
    },
    {
      "name": "Normal_from_relief",
      "type": "normal_map",
      "parameters": {
        "param0": 10,
        "param1": 0.86,
        "param2": 1,
        "param4": 1
      },
      "node_position": {
        "x": 940,
