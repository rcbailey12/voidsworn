    },
    {
      "name": "Surface",
      "type": "shader",
      "parameters": {},
      "node_position": {
        "x": 570,
        "y": -100
      },
      "shader_model": {
        "name": "Packed live relief and dry surface grain",
        "shortdesc": "Packed live relief and dry surface grain",
        "longdesc": "Packed live relief and dry surface grain",
        "instance": "",
        "code": [
          "vec2 warp = vec2($bend($uv + vec2(0.29, 0.33)), $bend($uv.yx + vec2(0.71, 0.18))) - 0.5;",
          "float flow = $land($uv + 0.31 * warp);",
          "float grit = $fine($uv - 0.12 * warp);",
          "float ash = $grain($uv);",
          "float lobe = smoothstep(0.29, 0.60, flow);",
          "float lip = sin(6.2831853 * (flow * 2.75 + 0.28 * grit));",
          "float hollow = 1.0 - smoothstep(0.26, 0.53, flow);",
          "float coarse_h = 0.451 + 0.44 * (lobe - 0.5) + 0.095 * lip * lobe;",
          "float fine_h = 0.5 + 1.49 * (grit - 0.5) + 0.035 * lip;",
          "float cavity = 1.0 - 0.15 * hollow;",
          "float albedo = 0.522 + 1.48 * (ash - 0.5) - 0.10 * hollow;",
          "float roughness = mix(0.49, 0.92, clamp(0.56 * hollow + 0.44 * grit, 0.0, 1.0));"
        ],
        "global": "",
        "inputs": [
          {
            "name": "bend",
            "label": "Bend",
            "type": "f",
            "default": "0.5"
          },
          {
            "name": "land",
            "label": "Land",
            "type": "f",
            "default": "0.5",
            "function": true
          },
          {
            "name": "fine",
            "label": "Fine",
            "type": "f",
            "default": "0.5",
            "function": true
          },
          {
            "name": "grain",
            "label": "Grain",
            "type": "f",
            "default": "0.5"
          }
        ],
        "outputs": [
          {
            "type": "rgba",
            "shortdesc": "Game RGBA",
            "rgba": "clamp(vec4(coarse_h, cavity, fine_h, albedo), 0.0, 1.0)"
          },
          {
            "type": "f",
            "shortdesc": "Height preview",
            "f": "coarse_h"
          },
          {
            "type": "f",
            "shortdesc": "Roughness",
            "f": "roughness"
          },
          {
            "type": "f",
            "shortdesc": "Color grain preview",
            "f": "albedo"
          }
        ],
        "parameters": []
      }
    },
    {
      "name": "Normal_from_relief",
