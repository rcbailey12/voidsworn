    {
      "name": "Dry_surface_grain",
      "type": "fbm4",
      "parameters": {
        "noise": 0,
        "scale_x": 32,
        "scale_y": 32,
        "iterations": 4,
        "folds": 0,
        "offset": 0,
        "persistence": 0.55,
        "lacunarity": 2
      },
      "node_position": {
        "x": 0,
