 "fixes": [
  [
   "Engine bells E1 to E6 inside each other; E2 and E5 exhausts on their neighbours",
   "exits set level at -7.25; centres spaced by the sum of the bell radii plus the lip"
  ],
  [
   "P2 and S2 barrels striking the hump at every aft bearing",
   "moved up onto the hump's front corners, superfiring over the neck deck"
  ],
  [
   "P1 and S1 barrels through the ear dishes D1 and D2",
   "ears moved to the head's front corners; P1 and S1 back to the neck deck, resting 30 degrees out"
  ],
  [
   "Ear dishes D1 and D2 had no mount on the hull",
   "each dish stands on its own base plate on the head roof"
  ],
  [
   "Q1 and Q2 bow thrusters inside the scoop drums, their exhaust on the drum ribs",
   "thrusters moved up the head flanks between the ears and the drums"
  ],
  [
   "Jaw blades inside the hull and the jaw housing",
   "each jaw has its own housing (its mount) in the cut-in mouth; the blades clear the hull"
  ],
  [
   "C2 girdle through the P2 and S2 turret rings",
   "C2 moved aft to -1.62, over the hump and crest, clear of every ring"
  ],
  [
   "Crest and belly turret housings sunk in the crest and the belly",
   "turrets now sit on their rings on the surface, plates cleared under each mount"
  ]
 ],
