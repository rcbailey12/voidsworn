+  # time limit: load 120 s, import 300 s, the list 780 s and the bot battle 360 s, 26 minutes in all (the A16 seam has its own job, issue 1174)
   # before setup and the Godot download, so the job can still be cut off (shown as "cancelled") by the 30 minute limit
   # when every step runs to its cap, as on the broken test commit 138ff38; the load gate makes that rare (audit 706, 9c).
   godot-game:
@@ -185,7 +185,7 @@ jobs:
           if grep -q 'SCRIPT ERROR' "$RUNNER_TEMP/load_all.log"; then echo "SCRIPT ERROR lines above"; bad=1; fi
           if [ $code -ne 0 ]; then echo "load_all.gd ended with exit code $code (124 or 137 is its 120 s time limit)"; bad=1; fi
           if [ $bad -ne 0 ]; then
-            echo 'The Godot checks after this step were not run (the A16 fixture step still runs: it needs no Godot): a file above does not load. Repair it first.' | tee -a "$GITHUB_STEP_SUMMARY"
