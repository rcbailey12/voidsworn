# Line endings in the repo, not a flag in every script (issue 357).
# Git stores LF in the repository and checks out the ending each file type needs.
# .bat and .cmd must be CRLF for cmd; the rest stay LF so a plain clone on the PC reads and runs them.
*.js text eol=lf
*.gd text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.py text eol=lf
*.patch text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.glb binary
*.png binary
*.jpg binary
*.webp binary
*.ogg binary
*.wav binary
# Independent check additions can land together. The check-list lint still rejects duplicate script entries.
godot/tools/ci/godot_checks.txt merge=union
godot/tools/ci/godot_check_times.txt merge=union
